# Server (localhost only by default)
VOICE_ADDR=127.0.0.1:8090
VOICE_MAX_RECORDING_SECONDS=30
VOICE_HISTORY_TURNS=8
VOICE_STT_TIMEOUT=60s
VOICE_LLM_TIMEOUT=30s
VOICE_TTS_TIMEOUT=30s
# Development-only, in-memory audio inspection over the authenticated browser session.
VOICE_AUDIO_DEBUG=false
# Development-only STT evaluation dashboard at /dev/ (localhost clients only).
# Fixtures come from `go run ./cmd/fetch-fixtures`; reports are written to VOICE_REPORT_DIR.
VOICE_DEV_TOOLS=false
VOICE_FIXTURES_DIR=runtime/fixtures
VOICE_REPORT_DIR=runtime/eval

# Local whisper.cpp server (multilingual model; never use *.en models).
# small is the default: base garbles Hindi/Hinglish (often in Urdu script).
WHISPER_URL=http://127.0.0.1:8081
WHISPER_MODEL=models/whisper/ggml-small.bin
# Hindi, Hinglish and Auto are routed to a second, more accurate model (English stays on
# WHISPER_MODEL for speed). Set WHISPER_MULTILINGUAL_URL= (empty) to use one server for all.
WHISPER_MULTILINGUAL_URL=http://127.0.0.1:8082
WHISPER_MULTILINGUAL_MODEL=models/whisper/ggml-large-v3-turbo-q5_0.bin
# Requests waiting per whisper-server (browser + devices share it); more fail fast with "busy".
WHISPER_MAX_QUEUE=4
# Seconds Whisper keeps its model wired in GPU memory after the last request.
# After a longer idle gap the first request is slow (25 min idle: 4.6 s instead of 0.4 s).
# Costs about 0.2% of one CPU core per server while idle; read by scripts/start-local.sh.
WHISPER_RESIDENCY_KEEP_ALIVE_S=3600
# Extra whisper-server decoding fields sent with every request, e.g. beam_size=5,temperature_inc=0.
# Leave unset to use the measured default (docs/STT_EVALUATION.md).
# WHISPER_OPTIONS=

# Gemini API (backend only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal
GEMINI_MAX_OUTPUT_TOKENS=220

# Two warm Piper services, one voice per process
PIPER_EN_URL=http://127.0.0.1:5000
PIPER_HI_URL=http://127.0.0.1:5001
PIPER_EN_VOICE=en_US-lessac-medium
PIPER_HI_VOICE=hi_IN-priyamvada-medium

# ---------------------------------------------------------------------------
# Phase 4: retrieval. Mode sent by clients that do not choose one (general, documents, web, auto).
VOICE_DEFAULT_MODE=auto
TOOL_MAX_CALLS_PER_TURN=2

# Web search (free Tavily plan, 1 credit per basic search). Leave the key empty to disable.
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=8s
WEB_SEARCH_CACHE_TTL=15m
# Test-only: point the Tavily client at a local mock server. Leave unset in normal use.
# TAVILY_BASE_URL=https://api.tavily.com

# Local document RAG. Files, extracted text and the index stay in RAG_STORAGE_PATH.
RAG_ENABLED=true
RAG_STORAGE_PATH=./data/rag
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_EMBEDDING_MODEL_DIR=models/embeddings/multilingual-e5-small
RAG_SIDECAR_URL=http://127.0.0.1:8084
RAG_TOP_K=5
RAG_CHUNK_TOKENS=350
RAG_CHUNK_OVERLAP=50
RAG_MAX_UPLOAD_MB=25
RAG_HYBRID_SEARCH=true
# Reciprocal rank fusion constant for combining keyword and vector rankings.
RAG_RRF_K=10
# Vector-only matches below this cosine similarity are treated as irrelevant.
RAG_MIN_SIMILARITY=0.78

# Privacy master switch. true (default) = the "Let Gemini read my documents" switch is available
# in the page; it is OFF in every new browser tab, and only while the professor turns it on are the
# few matching passages (never whole files) sent to Gemini. false = the switch is disabled
# everywhere and nothing from documents ever leaves the Mac (Documents mode lists matches locally).
RAG_SEND_CONTEXT_TO_GEMINI=true

# ---------------------------------------------------------------------------
# Browser WebSocket origins allowed to open /ws (default: this server's own address only).
# VOICE_ALLOWED_ORIGINS=127.0.0.1:8090,localhost:8090

# ESP32 devices (docs/DEVICE_PROTOCOL.md). Empty DEVICE_ADDR = no device listener.
# Set it to this Mac's LAN IP, e.g. 192.168.1.43:8443, after running devicectl init-ca/server-cert/add.
DEVICE_ADDR=
DEVICE_TLS_DIR=data/device-tls
DEVICE_REGISTRY=data/devices.json
DEVICE_FRAME_MS=20
DEVICE_PLAYBACK_LEAD_MS=200
DEVICE_MAX_CONNECTIONS=8
DEVICE_HEARTBEAT=15s
DEVICE_WRITE_TIMEOUT=3s
DEVICE_HELLO_TIMEOUT=5s
# DEVICE_UTTERANCE_TIMEOUT=35s          # default: VOICE_MAX_RECORDING_SECONDS + 5 s
# Desk-device document switch at startup (devices cannot tick a consent box). The professor can
# change it on the Documents page ("Desk device (ESP32)"); it resets to this value on restart and
# never applies while RAG_SEND_CONTEXT_TO_GEMINI=false.
DEVICE_ALLOW_DOC_CONTEXT=false
# Development only: echo mode and saving the exact received audio (one 0600 file per turn).
DEVICE_ECHO=false
DEVICE_DEBUG_AUDIO_DIR=

# ---------------------------------------------------------------------------
# Phase 5: professor tools (docs/PROFESSOR_TOOLS.md). Everything is stored locally.
PROFESSOR_TIMEZONE=Asia/Kolkata
PROFESSOR_DATA_PATH=./data/professor
# Working hours used to answer "do I have free time tomorrow?"
PROFESSOR_WORKDAY=09:00-17:00
TIMETABLE_ENABLED=true
REMINDERS_ENABLED=true
NOTES_ENABLED=true
VOICE_MEMOS_ENABLED=true
EMAIL_DRAFTS_ENABLED=true
# Changes proposed by the assistant wait this long for "yes"/"no" (or the page buttons), 10-600.
ACTION_CONFIRMATION_TIMEOUT_SECONDS=60
# Notes and voice-memo text stay on this Mac by default. With true, the web page shows a consent
# box; only sessions that tick it send the titles and text of the few matching notes to Gemini.
NOTES_SEND_TO_GEMINI=false
# ESP32 devices cannot tick a box: allow note/memo text for device questions (also needs the line above).
DEVICE_ALLOW_NOTE_CONTEXT=false
# What ESP32 devices may do: all (with voice confirmation), read (no changes) or none.
DEVICE_PROFESSOR_TOOLS=all
VOICE_MEMO_MAX_SECONDS=120
# Total kept memo recordings (audio is kept only when you tick "Keep the original audio").
VOICE_MEMO_MAX_STORAGE_MB=200
# Tool calls per question when professor tools are offered (finding a reminder, then changing it), 2-6.
PROFESSOR_TOOL_MAX_CALLS=4
# Offer Gemini only the professor tools a request needs (local multilingual embeddings + keywords,
# about 5 ms; uncertain requests still get every tool). Measured: first text 1775 -> 1394 ms median.
PROFESSOR_TOOL_ROUTING=true
# Gemini output limit when it may write an email/announcement draft (short answers stay short).
PROFESSOR_TOOL_OUTPUT_TOKENS=1024
# Also show due reminders as macOS notifications (needs the assistant running).
REMINDER_MACOS_NOTIFICATIONS=false

# Optional Google integrations (off unless configured). Create an OAuth client of type
# "Desktop app" (loopback redirects such as http://127.0.0.1:8090/... are then allowed).
# Calendar is read-only (calendar.events.readonly); Gmail only creates drafts (gmail.compose), never sends.
GOOGLE_CALENDAR_ENABLED=false
GMAIL_DRAFTS_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URL=http://127.0.0.1:8090/api/google/callback
# GOOGLE_TOKEN_PATH=./data/google-token.json

# Test-only (read by `go test`, not the app): VOICE_NETWORK_TESTS=1 enables tests that open localhost listeners.
# VOICE_NETWORK_TESTS=1

# ---------------------------------------------------------------------------
# Demo data (SQLite). `node backend/bin/db.js seed` fills separate demo databases and
# ./scripts/start-demo.sh serves them on DEMO_ADDR; your own data is not touched.
# development (default) or production. Seed and reset refuse to run in production without --force.
APP_ENV=development
# Folder for the demo professor database and demo document index (default ./data/demo).
DEMO_DATA_PATH=
# Address of the demo instance (default 127.0.0.1:8091).
DEMO_ADDR=
