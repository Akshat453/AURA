# Store every text file with LF line endings, whatever the editor or OS
# (Windows editors otherwise turn every file into a CRLF "change", and shell
# scripts with CRLF fail on macOS/Linux and in CI).
* text=auto eol=lf

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.wav  binary
*.mp3  binary
*.pdf  binary
*.docx binary
*.pptx binary
*.xlsx binary
*.onnx binary
*.bin  binary
